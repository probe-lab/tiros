# Copy to .env and fill in. Every variable is optional unless noted.
# The CLI reads these as flags; see the README for defaults.

# Global
TIROS_LOG_LEVEL=info
TIROS_LOG_FORMAT=text
TIROS_LOG_SOURCE=false
TIROS_METRICS_ENABLED=false
TIROS_METRICS_HOST=localhost
TIROS_METRICS_PORT=6060
TIROS_METRICS_PATH=/metrics
TIROS_TRACING_ENABLED=false
AWS_REGION=

# All probes
TIROS_PROBE_DRY_RUN=false
TIROS_PROBE_JSON_OUT=
TIROS_PROBE_TIMEOUT=0s

# ClickHouse
TIROS_PROBE_CLICKHOUSE_HOST=127.0.0.1
TIROS_PROBE_CLICKHOUSE_PORT=9000
TIROS_PROBE_CLICKHOUSE_DATABASE=tiros_local
TIROS_PROBE_CLICKHOUSE_USER=tiros_local
TIROS_PROBE_CLICKHOUSE_PASSWORD=
TIROS_PROBE_CLICKHOUSE_SSL=false
TIROS_PROBE_CLICKHOUSE_CLUSTER=
TIROS_PROBE_CLICKHOUSE_MIGRATIONS_TABLE=schema_migrations
TIROS_PROBE_CLICKHOUSE_MIGRATIONS_TABLE_ENGINE=TinyLog
TIROS_PROBE_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT=false
TIROS_PROBE_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT_MAX_SIZE=10485760
TIROS_PROBE_CLICKHOUSE_MIGRATIONS_REPLICATED_TABLE_ENGINES=false

# probe gateways and probe serviceworker (the service worker probe reads the same names)
TIROS_PROBE_GATEWAYS_INTERVAL=10s
TIROS_PROBE_GATEWAYS_ITERATIONS_MAX=0
TIROS_PROBE_GATEWAYS_CIDS=
TIROS_PROBE_GATEWAYS_DOWNLOAD_CIDS=
TIROS_PROBE_GATEWAYS_GATEWAYS=
TIROS_PROBE_GATEWAYS_DOWNLOAD_MAX_MB=10
TIROS_PROBE_GATEWAYS_TIMEOUT=30s
TIROS_PROBE_GATEWAYS_REFRESH_INTERVAL=5m
TIROS_PROBE_GATEWAYS_CONCURRENCY=10
TIROS_PROBE_GATEWAYS_CONTROLLED_CIDS=true
TIROS_PROBE_GATEWAYS_CONTROLLED_SHARE=0.2
# Secret: comma-separated gateway=key pairs
TIROS_PROBE_GATEWAYS_AUTH_KEYS=
TIROS_PROBE_GATEWAYS_CHROME_CDP_HOST=127.0.0.1
TIROS_PROBE_GATEWAYS_CHROME_CDP_PORT=3000

# probe kubo
TIROS_PROBE_KUBO_INTERVAL=10s
TIROS_PROBE_KUBO_ITERATIONS_MAX=0
TIROS_PROBE_KUBO_UPLOAD_FILE_SIZES_MIB=100
TIROS_PROBE_KUBO_DOWNLOAD_CIDS=
TIROS_PROBE_KUBO_DOWNLOAD_ONLY=false
TIROS_PROBE_KUBO_UPLOAD_ONLY=false
TIROS_PROBE_KUBO_KUBO_HOST=127.0.0.1
TIROS_PROBE_KUBO_KUBO_API_PORT=5001
TIROS_PROBE_KUBO_TRACES_RECEIVER_HOST=127.0.0.1
TIROS_PROBE_KUBO_TRACES_RECEIVER_PORT=4317
TIROS_PROBE_KUBO_TRACES_OUT=
TIROS_PROBE_KUBO_TRACES_FORWARD_HOST=
TIROS_PROBE_KUBO_TRACES_FORWARD_PORT=0

# probe websites
TIROS_PROBE_WEBSITES_PROBES=3
TIROS_PROBE_WEBSITES_WEBSITES=
TIROS_PROBE_WEBSITES_LOOKUP_PROVIDERS=true
TIROS_PROBE_WEBSITES_KUBO_HOST=127.0.0.1
TIROS_PROBE_WEBSITES_KUBO_API_PORT=5001
TIROS_PROBE_WEBSITES_KUBO_GATEWAY_PORT=8080
TIROS_PROBE_WEBSITES_CHROME_CDP_HOST=127.0.0.1
TIROS_PROBE_WEBSITES_CHROME_CDP_PORT=3000
TIROS_PROBE_WEBSITES_CHROME_KUBO_HOST=
